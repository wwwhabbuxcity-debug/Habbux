{
  "name": "habbux",
  "version": "0.1.0",
  "private": true,
  "description": "Fundação independente da plataforma Habbux",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "workspaces": [
    "apps/client",
    "apps/web"
  ],
  "scripts": {
    "client:dev": "npm run dev --workspace @habbux/client",
    "client:typecheck": "npm run typecheck --workspace @habbux/client",
    "client:build": "npm run build --workspace @habbux/client",
    "web:dev": "npm run dev --workspace @habbux/web",
    "web:typecheck": "npm run typecheck --workspace @habbux/web",
    "web:build": "npm run build --workspace @habbux/web",
    "typecheck": "npm run client:typecheck && npm run web:typecheck",
    "build": "npm run client:build && npm run web:build",
    "protocol:validate": "node tools/validate-protocol.mjs",
    "protocol:test": "node --test tests/protocol/*.test.mjs",
    "repository:check": "node tools/check-repository.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
