# Apenas desenvolvimento local. Nunca usar estas credenciais em produção.
HABBUX_ENV=development
GAME_WS_HOST=127.0.0.1
GAME_WS_PORT=3100
API_PORT=3101
CLIENT_DEV_PORT=5173
CLIENT_WS_URL=ws://127.0.0.1:3100/ws
WEB_DEV_PORT=5174
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=habbux_dev
POSTGRES_USER=habbux_dev
POSTGRES_PASSWORD=local-development-only
# Compose descartável compartilha o papel; bancos persistentes devem separar runtime/migration.
POSTGRES_MIGRATION_USER=habbux_dev
POSTGRES_MIGRATION_PASSWORD=local-development-only
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=2
POSTGRES_CONNECTION_TIMEOUT_MS=1500
POSTGRES_IDLE_TIMEOUT_MS=600000
POSTGRES_MAX_LIFETIME_MS=1800000
HABBUX_AUTH_THREADS=2
HABBUX_AUTH_QUEUE_LIMIT=8
REDIS_PORT=56379
# Core Netty: por segurança, escuta somente em loopback até existir proxy TLS configurado.
HABBUX_BIND_HOST=127.0.0.1
HABBUX_PORT=3100
HABBUX_EVENT_LOOP_THREADS=1
HABBUX_SHUTDOWN_TIMEOUT_MS=5000
HABBUX_MAX_PAYLOAD_BYTES=65536
HABBUX_HANDSHAKE_TIMEOUT_MS=10000
HABBUX_IDLE_TIMEOUT_SECONDS=120
HABBUX_MAX_CONNECTIONS=256
HABBUX_MAX_PRE_READY_MESSAGES=3
HABBUX_MESSAGE_RATE_PER_SECOND=30
HABBUX_MESSAGE_RATE_BURST=60
HABBUX_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Room Engine: limites explícitos para mailbox, pathfinding e tick compartilhado.
HABBUX_ROOM_WORKERS=2
HABBUX_MAX_ACTIVE_ROOMS=128
HABBUX_ROOM_MAILBOX_CAPACITY=512
HABBUX_ROOM_EVENTS_PER_RUN=32
HABBUX_ROOM_MAX_RUN_MS=2
HABBUX_ROOM_IDLE_TIMEOUT_MS=30000
HABBUX_MAX_ROOM_CAPACITY=100
HABBUX_ROOM_IO_QUEUE_CAPACITY=64
HABBUX_ROOM_MAX_EXPLORED_NODES=4096
HABBUX_ROOM_MAX_PATH_LENGTH=128
HABBUX_ROOM_MOVEMENT_TICK_MS=100
